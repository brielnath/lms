        <mxCell id="e3" value="login / token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#456A8A;" edge="1" parent="1" source="auth" target="siakad"><mxGeometry relative="1" as="geometry"/></mxCell>
