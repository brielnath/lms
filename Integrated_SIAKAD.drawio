        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#456A8A;" edge="1" parent="1" source="normalize" target="compare"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="800"/><mxPoint x="1230" y="550"/></Array></mxGeometry></mxCell>
