<mxfile host="app.diagrams.net" modified="2026-10-08T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="siakad-automatic-polling" name="Sinkronisasi Otomatis SIAKAD LMS">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="SINKRONISASI OTOMATIS SIAKAD → LMS PRODUCTION&#xa;Data baru diperiksa berkala dan ditambahkan ke LMS" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="350" y="25" width="1000" height="75" as="geometry"/></mxCell>
        <mxCell id="scheduler" value="Cron di server LMS&#xa;Memulai sinkronisasi pada interval yang ditentukan&#xa;(polling berkala, bukan instan)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="runner" value="Proses integrasi SIAKAD&#xa;Membaca konfigurasi semester dan kredensial aman dari server&#xa;Mencegah dua proses berjalan bersamaan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="485" width="320" height="145" as="geometry"/></mxCell>
        <mxCell id="auth" value="Autentikasi ke SIAKAD&#xa;POST /api/login&#xa;Terima access token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="270" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="sources" value="Ambil data semester dari SIAKAD&#xa;• /api/all-lessons: katalog, kode MK, nama, SKS&#xa;• /api/grades-per-course: KRS dan pasangan MK–dosen&#xa;• Endpoint kelas/peserta: NIM, nama, ID kelas&#xa;Data dibaca bertahap sesuai pagination API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="450" width="390" height="200" as="geometry"/></mxCell>
        <mxCell id="normalize" value="Rapikan dan validasi hasil&#xa;Samakan format NIM dan kode MK&#xa;Kelompokkan per semester dan kelas&#xa;Tolak/karantina hasil yang tidak lengkap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="730" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="compare" value="Cocokkan dengan data LMS&#xa;NIM → akun mahasiswa&#xa;Kode MK + semester → kelas LMS&#xa;ID/nama dosen → akun dan peran pengajar&#xa;Lewati data yang sudah tersinkron" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1280" y="455" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="write" value="Tambahkan data baru ke LMS&#xa;Buat kelas atau akun yang belum ada&#xa;Tambahkan cohort dan enrolment&#xa;Daftarkan mahasiswa/dosen pada kelas terkait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1280" y="730" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="log" value="Simpan hasil sinkronisasi&#xa;Jumlah data baru, data dilewati, dan error&#xa;Jika API gagal: catat error lalu coba lagi di interval berikutnya" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="980" width="390" height="130" as="geometry"/></mxCell>
        <mxCell id="siakad" value="SIAKAD USH&#xa;API akademik" style="shape=hexagon;perimeter=hexagonPerimeter;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="250" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="note" value="Rancangan target otomatis berdasarkan endpoint dan importer production yang tersedia di repo. Belum diaktifkan di server." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="350" y="1150" width="1000" height="25" as="geometry"/></mxCell>
