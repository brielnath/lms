{{!
    @template theme_academi/navbar
    Navbar: Logo + Kategori | Search | Panduan + Masuk/Daftar
}}
<nav id="header" class="ush-navbar fixed-top navbar navbar-light bg-white navbar-expand moodle-has-zindex" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid ush-navbar__inner">
        <div class="ush-navbar__left">
            <button class="navbar-toggler aabtn d-md-none border-0 px-1" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
                <span class="navbar-toggler-icon"></span>
                <span class="sr-only">{{#str}}sidepanel, core{{/str}}</span>
            </button>

            <a href="{{{ config.wwwroot }}}/?redirect=0" class="navbar-brand ush-navbar__brand {{# logourl }}has-logo{{/ logourl }}">
                {{#showlogo}}
                    {{# logourl }}
                        <span class="logo ush-navbar__logo">
                            <img src="{{logourl}}" alt="{{sitename}}">
                        </span>
                    {{/ logourl }}
                    {{^ logourl }}
                        <span class="ush-navbar__logo-fallback" aria-hidden="true"></span>
                        <span class="site-name">{{{ sitename }}}</span>
                    {{/ logourl }}
                {{/showlogo}}
                {{#showsitename}}
                    <span class="nav-site-name">{{{sitename}}}</span>
                {{/showsitename}}
                {{^showlogo}}
                    {{^showsitename}}
                        <span class="ush-navbar__logo-fallback" aria-hidden="true"></span>
                        <span class="site-name">{{{ sitename }}}</span>
                    {{/showsitename}}
                {{/showlogo}}
            </a>

            <div class="dropdown ush-navbar__kategori">
                <a class="nav-link dropdown-toggle" href="#" id="ushKategoriMenu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Kategori
                </a>
                <div class="dropdown-menu" aria-labelledby="ushKategoriMenu">
                    {{#ushcategories}}
                        <a class="dropdown-item" href="{{url}}">{{name}}</a>
                    {{/ushcategories}}
                    {{^ushcategories}}
                        <a class="dropdown-item" href="{{{ config.wwwroot }}}/course/index.php">Semua kategori</a>
                    {{/ushcategories}}
                </div>
            </div>

            {{#ushisloggedin}}
                {{#primarymoremenu}}
                    <div class="primary-navigation ush-navbar__moodle-nav d-none d-md-flex">
                        {{> core/moremenu}}
                    </div>
                {{/primarymoremenu}}
            {{/ushisloggedin}}
        </div>

        <form class="ush-navbar__search" action="{{{ushsearchurl}}}" method="get" role="search">
            <label class="sr-only" for="ush-navbar-search">Cari</label>
            <span class="ush-navbar__search-icon" aria-hidden="true">
                <i class="fa fa-search"></i>
            </span>
            <input id="ush-navbar-search" type="search" name="search" class="form-control" placeholder="" autocomplete="off">
        </form>

        <div class="ush-navbar__right" id="usernavigation">
            <a class="ush-navbar__link" href="{{{ushpanduanurl}}}">Panduan</a>
            {{^ushisloggedin}}
                <a class="ush-navbar__link" href="{{{ushloginurl}}}">Masuk</a>
                <a class="ush-navbar__link" href="{{{ushsignupurl}}}">Daftar</a>
            {{/ushisloggedin}}
            {{#ushisloggedin}}
                {{{ output.navbar_plugin_output }}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{#usermenu}}
                        {{> core/user_menu }}
                    {{/usermenu}}
                </div>
                {{{ output.edit_switch }}}
            {{/ushisloggedin}}
        </div>
    </div>
</nav>
{{> theme_boost/primary-drawer-mobile }}
